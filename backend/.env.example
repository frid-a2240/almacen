# Base de datos
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/tools_id_isp_warehouse

# App
APP_NAME=ALMACEN ISP
APP_VERSION=0.1.0
DEBUG=True

# Uploads (usar ruta absoluta en el servidor, ver guía de despliegue)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# CORS (en el servidor puede dejarse abierto: el dashboard queda en el mismo origen que la API,
# y el APK llama desde el WebView de Capacitor, otro origen)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth (generar un JWT_SECRET nuevo por entorno, nunca reutilizar el de la laptop)
JWT_SECRET=CAMBIAR_GENERAR_UNO_NUEVO
JWT_EXPIRE_DAYS=3650
