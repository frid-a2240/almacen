<?xml version="1.0" encoding="utf-8"?>
<!--
  Ajusta las 3 apariciones de la ruta si clonas el repo en un lugar distinto
  de D:\Aplicaciones\wwwroot\almacen. Ver README > Despliegue en el servidor.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified"/>
    </handlers>
    <httpPlatform processPath="D:\Aplicaciones\wwwroot\almacen\backend\venv312\Scripts\python.exe"
                  arguments="D:\Aplicaciones\wwwroot\almacen\runserver.py --port %HTTP_PLATFORM_PORT%"
                  startupTimeLimit="60"
                  stdoutLogEnabled="true"
                  stdoutLogFile="D:\Aplicaciones\wwwroot\almacen\logs\stdout.log">
    </httpPlatform>
  </system.webServer>
</configuration>
